{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FrostPi Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/extension/**/*.cjs", "${workspaceFolder}/apps/vscode/dist/pi-extensions/**/*.js"],
      "preLaunchTask": "build:debug"
    }
  ]
}

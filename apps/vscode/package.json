{
  "name": "frostpi",
  "displayName": "Pi VS Code UI — FrostPi",
  "description": "A visual VS Code UI for Pi Coding Agent that uses your existing Pi configuration, extensions, models, sessions, and workflows.",
  "version": "0.17.0",
  "publisher": "frostime",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#111318",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pi",
    "pi coding agent",
    "pi agent",
    "pi vscode",
    "pi vscode ui",
    "pi gui",
    "vscode",
    "vscode ai",
    "coding agent",
    "ai coding agent",
    "gui",
    "rpc",
    "ai"
  ],
  "homepage": "https://github.com/frostime/pi-vscode-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/frostime/pi-vscode-ui.git"
  },
  "bugs": {
    "url": "https://github.com/frostime/pi-vscode-ui/issues"
  },
  "main": "./dist/extension/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "FrostPi launches Pi with access to the current workspace and should only run in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onView:frostpi.chat",
    "onCommand:frostpi.newSession",
    "onCommand:frostpi.newSessionInEditorTab",
    "onCommand:frostpi.newTemporarySession",
    "onCommand:frostpi.newTemporarySessionInEditorTab",
    "onCommand:frostpi.renameSession",
    "onCommand:frostpi.stopSession",
    "onCommand:frostpi.deleteSession",
    "onCommand:frostpi.toggleRunningTurnCollapse",
    "onCommand:frostpi.resumeSession",
    "onCommand:frostpi.focus",
    "onCommand:frostpi.sendSelection",
    "onCommand:frostpi.sendFile",
    "onCommand:frostpi.stop",
    "onCommand:frostpi.exportDiagnostics",
    "onCommand:frostpi.configureExecutable",
    "onCommand:frostpi.restartSession",
    "onCommand:frostpi.restartAllSessions",
    "onCommand:frostpi.configureProxy",
    "onCommand:frostpi.configureProxyCredentials",
    "onCommand:frostpi.copyLinkAddress",
    "onCommand:frostpi.copyLinkPath"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frostpi",
          "title": "FrostPi",
          "icon": "assets/activity-bar.svg"
        }
      ]
    },
    "views": {
      "frostpi": [
        {
          "type": "webview",
          "id": "frostpi.chat",
          "name": "FrostPi",
          "contextualTitle": "FrostPi"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "frostpi.chat",
        "contents": "Open a trusted folder to start a Pi session.\n[Open Folder](command:vscode.openFolder)",
        "when": "!workspaceFolderCount"
      }
    ],
    "commands": [
      {
        "command": "frostpi.focus",
        "title": "FrostPi: Focus Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "frostpi.newSession",
        "title": "FrostPi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "frostpi.newSessionInEditorTab",
        "title": "FrostPi: New Session in Editor Tab",
        "icon": "$(add)"
      },
      {
        "command": "frostpi.newTemporarySession",
        "title": "FrostPi: New Temporary Session",
        "icon": "$(eye-closed)"
      },
      {
        "command": "frostpi.newTemporarySessionInEditorTab",
        "title": "FrostPi: New Temporary Session in Editor Tab",
        "icon": "$(eye-closed)"
      },
      {
        "command": "frostpi.renameSession",
        "title": "FrostPi: Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "frostpi.stopSession",
        "title": "FrostPi: Stop Pi Process",
        "icon": "$(debug-stop)"
      },
      {
        "command": "frostpi.deleteSession",
        "title": "FrostPi: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "frostpi.toggleRunningTurnCollapse",
        "title": "FrostPi: Toggle Running-Turn Collapse (Focus View)",
        "icon": "$(list-tree)"
      },
      {
        "command": "frostpi.resumeSession",
        "title": "FrostPi: Resume Existing Session",
        "icon": "$(history)"
      },
      {
        "command": "frostpi.sendSelection",
        "title": "FrostPi: Mention Selection Path in Prompt"
      },
      {
        "command": "frostpi.sendFile",
        "title": "FrostPi: Mention Current File in Prompt"
      },
      {
        "command": "frostpi.stop",
        "title": "FrostPi: Stop Response",
        "icon": "$(debug-stop)"
      },
      {
        "command": "frostpi.exportDiagnostics",
        "title": "FrostPi: Export Diagnostics"
      },
      {
        "command": "frostpi.configureExecutable",
        "title": "FrostPi: Configure Pi Executable"
      },
      {
        "command": "frostpi.restartSession",
        "title": "FrostPi: Restart Current Session",
        "icon": "$(debug-restart)"
      },
      {
        "command": "frostpi.restartAllSessions",
        "title": "FrostPi: Restart All Sessions"
      },
      {
        "command": "frostpi.configureProxy",
        "title": "FrostPi: Configure Network Proxy"
      },
      {
        "command": "frostpi.configureProxyCredentials",
        "title": "FrostPi: Configure Proxy Credentials"
      },
      {
        "command": "frostpi.copyLinkAddress",
        "title": "Copy Link Address"
      },
      {
        "command": "frostpi.copyLinkPath",
        "title": "Copy Path"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "frostpi.copyLinkAddress",
          "when": "false"
        },
        {
          "command": "frostpi.copyLinkPath",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "frostpi.copyLinkAddress",
          "when": "(webviewId == 'frostpi.chat' || webviewId =~ /^frostpi\\.session\\.[0-9]+$/) && webviewSection == 'frostpiWebLink'",
          "group": "frostpi@1"
        },
        {
          "command": "frostpi.copyLinkPath",
          "when": "(webviewId == 'frostpi.chat' || webviewId =~ /^frostpi\\.session\\.[0-9]+$/) && webviewSection == 'frostpiFileLink'",
          "group": "frostpi@1"
        }
      ],
      "editor/context": [
        {
          "command": "frostpi.sendSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "frostpi@1"
        },
        {
          "command": "frostpi.sendFile",
          "when": "resourceScheme == file",
          "group": "frostpi@2"
        }
      ],
      "editor/title": [
        {
          "command": "frostpi.newSessionInEditorTab",
          "alt": "frostpi.newTemporarySessionInEditorTab",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "navigation@1"
        },
        {
          "command": "frostpi.newTemporarySessionInEditorTab",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "frostpi@0"
        },
        {
          "command": "frostpi.renameSession",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "frostpi@1"
        },
        {
          "command": "frostpi.toggleRunningTurnCollapse",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "frostpi@2"
        },
        {
          "command": "frostpi.stopSession",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "frostpi-session@1"
        },
        {
          "command": "frostpi.deleteSession",
          "when": "activeWebviewPanelId =~ /^frostpi\\.session\\.[0-9]+$/",
          "group": "frostpi-session@2"
        }
      ]
    },
    "configuration": {
      "title": "FrostPi",
      "properties": {
        "frostpi.pi.executable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional Pi executable or Node.js CLI path. Leave empty to resolve the selected runtime from PATH."
        },
        "frostpi.pi.runtimeCompatibility": {
          "type": "string",
          "enum": [
            "pi",
            "oh-my-pi"
          ],
          "enumDescriptions": [
            "Existing Pi behavior and Pi settings semantics.",
            "Limited FrostPi compatibility with Oh My Pi launch, RPC, session discovery, and resume; this does not represent complete OMP support."
          ],
          "default": "pi",
          "scope": "resource",
          "description": "Select FrostPi's limited compatibility contract for a Pi-compatible runtime; this does not claim support for all runtime-specific features."
        },
        "frostpi.pi.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional arguments passed after `pi --mode rpc`."
        },
        "frostpi.session.startOnOpen": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "When a previously selected session exists, start its Pi process when FrostPi activates. Does not create a new session if none exist."
        },
        "frostpi.session.closeWithEditorTab": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Closing a session's editor tab also closes the session: its Pi process stops and it leaves the session list, as Close session in the list does. Pi's session file is kept, so Resume session can reopen it. When off, the session keeps running in the sidebar."
        },
        "frostpi.composer.streamingBehavior": {
          "type": "string",
          "enum": [
            "steer",
            "followUp"
          ],
          "enumDescriptions": [
            "Deliver while the current run is active, after current tool calls.",
            "Deliver only after the current run fully settles."
          ],
          "default": "followUp",
          "scope": "resource",
          "description": "Default delivery for normal prompts submitted while Pi is streaming. The Composer can override it per session; extension commands execute immediately."
        },
        "frostpi.conversation.collapseTurnTrace": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "After a turn completes, fold its tool calls, reasoning and interim replies into one summary above the final reply. Inside an opened summary, each run of tool calls and reasoning stays folded into one row. How a turn folds while it is still running is controlled by frostpi.conversation.collapseRunningTurnTrace."
        },
        "frostpi.conversation.collapseRunningTurnTrace": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "While a turn is still running, fold each run of consecutive tool calls and reasoning into one expandable row. Replies stay visible. How finished turns fold is controlled by frostpi.conversation.collapseTurnTrace. \"FrostPi: Toggle Running-Turn Collapse (Focus View)\" switches it."
        },
        "frostpi.questionTool.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Inject FrostPi's private question tool when a Pi session process starts. Running sessions must be restarted after this setting changes."
        },
        "frostpi.attachments.maxImageBytes": {
          "type": "number",
          "minimum": 1048576,
          "maximum": 52428800,
          "default": 10485760,
          "scope": "resource",
          "description": "Maximum size in bytes per image. Pasted images over this limit cannot be attached. Images loaded from local files or HTTPS links in the conversation are also rejected if they exceed the limit."
        },
        "frostpi.diagnostics.level": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "scope": "window",
          "description": "Verbosity of the FrostPi output channel. Prompt and model content are not logged."
        },
        "frostpi.notifications.experimental.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Experimental: Notify when an agent turn completes, a session fails, or FrostPi waits for input while the VS Code window is unfocused. Local Windows uses a native PowerShell toast; unavailable native delivery falls back to a VS Code notification."
        },
        "frostpi.network.proxy.mode": {
          "type": "string",
          "enum": [
            "inherit",
            "vscode",
            "custom",
            "direct"
          ],
          "enumDescriptions": [
            "Inherit the Extension Host environment.",
            "Use the VS Code http.proxy setting.",
            "Inject FrostPi custom proxy variables.",
            "Remove inherited proxy variables for Pi."
          ],
          "default": "inherit",
          "scope": "machine-overridable",
          "description": "Proxy mode applied when a Pi session process starts. Running sessions must be restarted."
        },
        "frostpi.network.proxy.endpoint": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Custom proxy endpoint for custom mode. host:port or http(s)://… sets HTTP_PROXY and HTTPS_PROXY; socks5://… sets ALL_PROXY. Store authentication through the FrostPi credentials command."
        },
        "frostpi.network.proxy.noProxy": {
          "type": "string",
          "default": "localhost,127.0.0.1,::1",
          "scope": "machine-overridable",
          "description": "Comma-separated hosts that bypass the proxy. Defaults to local loopback addresses. Edit in Settings when the default loopback list is not enough."
        },
        "frostpi.composer.fileMentions.respectSearchExclude": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Exclude paths matched by VS Code search.exclude from @ path completion."
        },
        "frostpi.composer.fileMentions.respectIgnoreFiles": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Respect .gitignore, .ignore, .fdignore, and global ignore rules during @ path completion."
        },
        "frostpi.composer.fileMentions.followSymlinks": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Follow symbolic links during @ path completion. Off by default: a link to a large directory outside the workspace, or a link loop, can make the search slow or fill it with duplicates."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs --scope vscode",
    "clean": "node ../../scripts/clean-dir.mjs dist coverage .vscode-test",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test build.mjs --max-warnings 0"
  },
  "dependencies": {
    "@frostime/pi-client": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@frostime/pi-rpc": "workspace:*",
    "@frostime/provider-usage": "workspace:*",
    "@vscode/codicons": "^0.0.44",
    "bits-ui": "^2.18.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.2",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.16.1",
    "minimatch": "^10.2.5",
    "svelte": "^5.56.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.1.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "eslint-plugin-svelte": "^3.11.0",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.1",
    "svelte-eslint-parser": "^1.3.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

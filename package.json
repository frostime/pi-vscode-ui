{
  "name": "frostpi-workspace",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:vscode": "node scripts/build.mjs --scope vscode",
    "build:desktop": "node scripts/build.mjs --scope desktop",
    "clean": "node scripts/clean.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "typecheck": "node scripts/quality.mjs typecheck",
    "test": "node scripts/quality.mjs test",
    "lint": "node scripts/quality.mjs lint",
    "check": "node scripts/check.mjs",
    "check:vscode": "node scripts/check.mjs --scope vscode",
    "package:vsix": "node scripts/package-vsix.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "package:source": "node scripts/package-source.mjs",
    "check:desktop:native": "pnpm --dir apps/desktop check:native",
    "package:desktop": "pnpm --dir apps/desktop package:app",
    "verify:desktop": "pnpm --dir apps/desktop verify:package",
    "test:desktop:manual": "pnpm --dir apps/desktop test:manual",
    "prepare:desktop:release": "pnpm --dir apps/desktop prepare:release",
    "publish:marketplace": "node scripts/publish-marketplace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "eslint": "^9.32.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^16.3.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "type": "module"
}
